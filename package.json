{
  "name": "spotitube",
  "productName": "SpotiTube",
  "version": "0.7.0",
  "description": "Unified Spotify + YouTube Music desktop player.",
  "homepage": "https://github.com/Roguu2/SpotiTube",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roguu2/SpotiTube.git"
  },
  "main": "./out/main/index.js",
  "author": "SpotiTube",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true
  }
}
